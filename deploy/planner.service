# systemd --user unit for the planner.
# Install:  cp deploy/planner.service ~/.config/systemd/user/
#           systemctl --user daemon-reload && systemctl --user enable --now planner
#           sudo loginctl enable-linger rahuldeb5   # start at boot, without logging in
[Unit]
Description=Personal planner (FastAPI + SQLite)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/schedule-app
Environment=PLANNER_DB=%h/planner-data/planner.db
Environment=HOST=127.0.0.1
Environment=PORT=8000
ExecStart=%h/schedule-app/.venv/bin/python -m planner
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
